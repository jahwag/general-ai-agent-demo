[Unit]
Description=Human-approved Freshservice write consumer
After=gaidemo-agentbus.service gaidemo-freshworks-read.service
Requires=gaidemo-agentbus.service

[Service]
Type=simple
User=gaidemo-operator
Group=gaidemo-operators
EnvironmentFile=/etc/gaidemo/agentbus.env
ExecStart=/opt/general-ai-agent/.venv/bin/python -I -m democtl.approval_gateway
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/var/lib/gaidemo-approval
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
