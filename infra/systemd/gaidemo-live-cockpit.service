[Unit]
Description=Live operator cockpit for the Freshservice capability demo
After=gaidemo-agentbus.service
Requires=gaidemo-agentbus.service

[Service]
Type=simple
User=gaidemo-human
Group=gaidemo-human
EnvironmentFile=/etc/gaidemo-human/cockpit.env
ExecStart=/opt/general-ai-agent/.venv/bin/python -I -m democtl.live_cockpit --listen 127.0.0.1 --port 8765
Restart=on-failure
RestartSec=2
UMask=0007
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gaidemo-human
InaccessiblePaths=/etc/gaidemo /etc/gaidemo-approver /var/lib/gaidemo-operator /var/lib/gaidemo-approval /var/lib/gaidemo-approver
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

[Install]
WantedBy=multi-user.target
