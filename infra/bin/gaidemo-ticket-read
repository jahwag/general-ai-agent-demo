#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 || ! $1 =~ ^[1-9][0-9]*$ ]]; then
  echo "usage: gaidemo-ticket-read TICKET_ID" >&2
  exit 2
fi

exec /usr/bin/curl \
  --fail \
  --silent \
  --show-error \
  --unix-socket /run/gaidemo/freshworks-read.sock \
  "http://localhost/api/demo/tickets/$1"
