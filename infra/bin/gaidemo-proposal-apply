#!/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 2 || $1 != "APPROVE" || -z $2 ]]; then
  echo 'usage: gaidemo-proposal-apply APPROVE EXPECTED_UPDATED_AT' >&2
  exit 3
fi

set -a
# shellcheck disable=SC1091
source /etc/gaidemo/freshworks.env
set +a

cd /opt/general-ai-agent
exec /opt/general-ai-agent/.venv/bin/python -I -m democtl \
  proposal apply /home/gaidemo-copilot/gaidemo/artifacts/proposal.json \
  --approve "$1" \
  --expected-updated-at "$2"
