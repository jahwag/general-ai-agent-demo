#!/usr/bin/env bash
set -euo pipefail

if [[ $# -lt 1 || $# -gt 2 || -z $1 ]]; then
  echo 'usage: gaidemo-kb-search QUERY [LIMIT]' >&2
  exit 2
fi
if [[ ! ${2:-3} =~ ^[1-9][0-9]*$ ]]; then
  echo 'LIMIT must be a positive integer' >&2
  exit 2
fi

exec /usr/bin/curl \
  --fail \
  --silent \
  --show-error \
  --get \
  --unix-socket /run/gaidemo-kb/bookstack-read.sock \
  --data-urlencode "query=$1" \
  --data-urlencode "limit=${2:-3}" \
  http://localhost/api/demo/kb/search
